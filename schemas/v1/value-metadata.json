{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rhcjw/paypack-specs/raw/main/schemas/v1/value-metadata.json",
  "title": "PayPack Value Metadata (PVM)",
  "description": "Valuation & trust overlay for agentic payments. Sits on top of x402/AP2/Alipay/WeChat, answering: Is this price fair? Is this merchant trustworthy?",
  "type": "object",
  "required": ["spec_version", "service_code"],
  "properties": {
    "spec_version": {
      "type": "string",
      "description": "PVM specification version, e.g. 0.1.0",
      "default": "0.1.0"
    },
    "service_code": {
      "type": "string",
      "description": "Service type identifier, reverse-domain notation (e.g. com.weather.pro.v1)"
    },
    "service_name": {
      "type": "string",
      "description": "Human-readable service name"
    },
    "price_index": {
      "$ref": "./price-index.json",
      "description": "Current price index for this service"
    },
    "merchant_credit": {
      "$ref": "./credit-score.json",
      "description": "Merchant credit score and dimensions"
    },
    "feedback_aggregate": {
      "type": "object",
      "description": "Aggregated user feedback for this merchant/service",
      "properties": {
        "total_reviews": { "type": "integer" },
        "weighted_score": { "type": "number", "minimum": 0, "maximum": 5 },
        "distribution": {
          "type": "object",
          "properties": {
            "1": { "type": "integer" },
            "2": { "type": "integer" },
            "3": { "type": "integer" },
            "4": { "type": "integer" },
            "5": { "type": "integer" }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "last_30d_reviews": { "type": "integer" }
      }
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "BLOCKED"],
      "description": "Overall risk assessment. Determined per rules defined in specs/risk-assessment.md based on trust_score, price fairness, and feedback confidence."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    }
  }
}
